# ============================================================
# Cryptsk — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file.
# ============================================================

# --- Database (SQLite for dev; swap for PostgreSQL/MySQL in production) ---
DATABASE_URL="file:./db/custom.db"

# --- NextAuth.js ---
NEXTAUTH_SECRET="change-me-to-a-32+char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Logging ---
LOG_LEVEL="info"
DEBUG="false"

# --- GitHub auto-push (optional, used by mini-services/git-autopush) ---
# GITHUB_TOKEN=""
# GITHUB_REPO="chiranjitk/mozilaossbss"

# --- Payment Gateway Keys (production only) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# --- Communication Channels (production only) ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
