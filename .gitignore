# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==============================
# Dependencies
# ==============================
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lockb

# ==============================
# Testing
# ==============================
/coverage
*.lcov

# ==============================
# Next.js
# ==============================
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ==============================
# Production / Build artifacts
# ==============================
dist/
*.tsbuildinfo

# ==============================
# Environment & secrets (NEVER commit)
# ==============================
.env
.env.*
!.env.example
!.env.sample
.env.local
.env.development
.env.production
.env.test

# ==============================
# Database files (SQLite - binary, changes constantly)
# ==============================
*.db
*.db-journal
*.sqlite
*.sqlite3
db/*.db
db/*.db-journal
prisma/*.db
prisma/*.db-journal

# ==============================
# Logs & runtime artifacts
# ==============================
*.log
dev.log
dev.out.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==============================
# Runtime / pid / lock files
# ==============================
*.pid
.zscripts/dev.pid
*.lock
!bun.lock
!package-lock.json
!pnpm-lock.yaml

# ==============================
# OS / Editor
# ==============================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ==============================
# Misc / sandbox internal
# ==============================
local-*
.claude
.z-ai-config
test
prompt
download/
agent-ctx/
screenshots/
.zscripts/
.cursor/
.cache/
tmp/
*.tmp

# ==============================
# Uploads / user-generated content
# ==============================
uploads/
public/uploads/
