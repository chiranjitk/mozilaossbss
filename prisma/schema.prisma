// =====================================================================
// CRYPTSK PRISMA SCHEMA — Phase 0 Foundation
// =====================================================================
// Universal Core + Industry Modules architecture.
// SQLite for dev sandbox. PostgreSQL-ready (no SQLite-coupled business logic).
// All entities are tenant-aware where multi-tenancy is meaningful.
// Decimal-safe money via Prisma Decimal (never floating point).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// CORE — TENANCY
// =====================================================================

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  edition     String   @default("enterprise") // isp | enterprise | msp | hospitality | campus | telecom | datacenter | government
  timezone    String   @default("UTC")
  locale      String   @default("en")
  currency    String   @default("USD")
  status      String   @default("active") // active | suspended | locked
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  modules     ModuleState[]
  auditLogs   AuditLog[]
  settings    SystemSetting[]
  notifications Notification[]
  subscribers Subscriber[]
  plans       Plan[]
  nasClients  NasClient[]
  activeSessions ActiveSession[]
  sessionHistories SessionHistory[]
  invoices    Invoice[]
  payments    Payment[]
  complaints  Complaint[]
  technicians Technician[]
  subnets     Subnet[]
  ipAddresses IpAddress[]
  dhcpLeases  DhcpLease[]
  dnsZones    DnsZone[]
  dnsRecords  DnsRecord[]
  systemInterfaces SystemInterface[]
  vouchers    Voucher[]
  installations Installation[]
  inventoryItems InventoryItem[]
  incidents   Incident[]
  metricData  MetricData[]
  alerts      Alert[]
  syslogEntries SyslogEntry[]
  paymentGatewayConfigs PaymentGatewayConfig[]
  bandwidthProfiles BandwidthProfile[]
  qosQueues QosQueue[]
  firewallRules FirewallRule[]
  timeAccessProfiles TimeAccessProfile[]
  collectionTasks CollectionTask[]
}

// =====================================================================
// CORE — IDENTITY & RBAC
// =====================================================================

model User {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String   @unique
  username        String   @unique
  passwordHash    String
  name            String?
  avatarUrl       String?
  phone           String?
  status          String   @default("active") // active | disabled | locked | invited
  lastLoginAt     DateTime?
  lastLoginIp     String?
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userRoles       UserRole[]
  auditLogs       AuditLog[]
  sessions       ActiveSession[]   @relation("SessionOperator")
  complaintsAssigned Complaint[]
  incidentsAssigned Incident[]
  technician      Technician?

  @@index([tenantId])
  @@index([status])
}

model Role {
  id            String         @id @default(cuid())
  tenantId      String?
  name          String         @unique
  description   String?
  isSystem      Boolean        @default(false) // system roles cannot be deleted
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  permissions   RolePermission[]
  users         UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. billing.invoice.read, subscriber.create
  module      String   // billing, subscriber, aaa, network, etc.
  action      String   // read, create, update, delete, suspend, etc.
  description String?
  createdAt    DateTime @default(now())

  roles       RolePermission[]
}

model RolePermission {
  roleId      String
  permissionId String
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId   String
  roleId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// =====================================================================
// CORE — MODULE REGISTRY (persisted enable/disable state)
// =====================================================================

model ModuleState {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId    String   // matches id in src/core/modules/registry.ts
  enabled     Boolean  @default(false)
  licensed    Boolean  @default(false)
  licenseExpiry DateTime?
  config      String?  // JSON-encoded module-specific config
  health      String   @default("unknown") // healthy | degraded | down | unknown
  workerStatus String  @default("stopped") // running | stopped | error
  lastStartedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, moduleId])
  @@index([tenantId, enabled])
}

// =====================================================================
// CORE — AUDIT LOG
// =====================================================================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g. subscriber.suspend
  module      String
  resource    String
  resourceId  String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  oldValue     String? // JSON
  newValue     String? // JSON
  status       String  @default("success") // success | failure | error
  message      String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([module, action])
  @@index([resource, resourceId])
}

// =====================================================================
// CORE — SYSTEM SETTINGS (key/value store, tenant-scoped)
// =====================================================================

model SystemSetting {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  category  String   @default("general") // general | billing | network | notification | ai | ...
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([tenantId, key])
  @@index([category])
}

// =====================================================================
// CORE — NOTIFICATIONS
// =====================================================================

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  // null = broadcast to tenant
  title     String
  message   String
  level     String   @default("info") // info | success | warning | error
  category  String?  // system | billing | aaa | network | ...
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, userId, readAt])
  @@index([createdAt])
}

// =====================================================================
// CUSTOMER (Phase 2) — minimal stub now for dashboard KPIs
// =====================================================================

model Subscriber {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String   @unique // human-friendly ID
  firstName    String
  lastName     String
  email        String?
  phone        String?
  address      String?
  status       String   @default("active") // active | suspended | terminated | pending
  planId       String?
  plan         Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  username     String?  @unique // RADIUS username
  passwordHash String?  // RADIUS password (hashed)
  metadata     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activeSessions ActiveSession[]
  sessionHistories SessionHistory[]
  invoices    Invoice[]
  payments    Payment[]
  complaints  Complaint[]
  vouchers    Voucher[]
  installations Installation[]
  collectionTasks CollectionTask[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model Plan {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  code          String   @unique
  description   String?
  price         Decimal  
  currency      String   @default("USD")
  billingCycle  String   @default("monthly") // monthly | quarterly | yearly | one_time
  downloadSpeed Int?     // kbps
  uploadSpeed   Int?     // kbps
  dataCap       Int?     // MB, null = unlimited
  sessionLimit  Int      @default(1)
  taxRate       Decimal  @default(0) 
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscribers   Subscriber[]
  vouchers    Voucher[]

  @@index([tenantId, status])
}

// =====================================================================
// AAA (Phase 3) — stubs for dashboard
// =====================================================================

model NasClient {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  ipAddress    String   @unique
  sharedSecret String
  type         String   @default("generic") // mikrotik | cisco | generic | ...
  coaPort      Int      @default(3799)
  status       String   @default("active")
  lastSeenAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activeSessions ActiveSession[]
  sessionHistories SessionHistory[]

  @@index([tenantId, status])
}

model ActiveSession {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId        String   @unique // RADIUS Acct-Session-Id
  subscriberId     String?
  subscriber       Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  nasId            String
  nas              NasClient @relation(fields: [nasId], references: [id], onDelete: Cascade)
  operatorId       String?
  operator         User?    @relation("SessionOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  username         String
  nasIpAddress     String
  framedIpAddress   String?
  nasPortId        String?
  callingStationId  String? // MAC
  calledStationId   String?
  protocol         String? // PPP | PPPoE | Ethernet | Wireless
  startTime        DateTime @default(now())
  updateTime       DateTime @updatedAt
  inputOctets      BigInt   @default(0)
  outputOctets     BigInt   @default(0)
  inputGigawords   Int      @default(0)
  outputGigawords  Int      @default(0)
  sessionTimeout   Int?     // seconds
  status           String   @default("active") // active | stopped | expired
  terminationCause String?
  createdAt        DateTime @default(now())

  @@index([tenantId, status])
  @@index([subscriberId])
  @@index([nasId])
  @@index([framedIpAddress])
  @@index([username])
  @@index([startTime])
}

model SessionHistory {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId        String
  subscriberId     String?
  subscriber       Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  nasId            String
  nas              NasClient @relation(fields: [nasId], references: [id], onDelete: Cascade)
  username         String
  nasIpAddress     String
  framedIpAddress   String?
  callingStationId  String?
  startTime        DateTime
  stopTime         DateTime?
  duration         Int?     // seconds
  inputOctets      BigInt   @default(0)
  outputOctets     BigInt   @default(0)
  terminationCause String?
  createdAt        DateTime @default(now())

  @@index([tenantId, startTime])
  @@index([subscriberId])
  @@index([nasId])
  @@index([username])
}

// =====================================================================
// BILLING / PAYMENTS (Phase 7-8) — stubs for dashboard
// =====================================================================

model Invoice {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String   @unique
  subscriberId String?
  subscriber  Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  issueDate   DateTime @default(now())
  dueDate     DateTime
  subtotal    Decimal  
  taxAmount   Decimal  @default(0) 
  total       Decimal  
  amountPaid  Decimal  @default(0) 
  status      String   @default("draft") // draft | issued | paid | partial | overdue | cancelled
  currency    String   @default("USD")
  items       String?  // JSON array of line items
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]
  collectionTasks CollectionTask[]

  @@index([tenantId, status])
  @@index([subscriberId])
  @@index([dueDate])
}

model Payment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       String   @unique
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscriberId String?
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  amount       Decimal  
  currency     String   @default("USD")
  method       String   @default("manual") // cash | card | bank | upi | wallet | gateway | manual
  gateway      String?  // stripe | razorpay | paypal | ...
  gatewayRef   String?
  status       String   @default("completed") // pending | completed | failed | refunded
  reconciled   Boolean  @default(false)
  reconciledAt DateTime?
  notes        String?
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId, status])
  @@index([invoiceId])
  @@index([subscriberId])
  @@index([gateway, status])
}

model PaymentGatewayConfig {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // stripe | razorpay | paypal | manual | custom
  displayName String?
  adapter     String   // stripe | razorpay | paypal | manual
  enabled     Boolean  @default(false)
  isDefault   Boolean  @default(false)
  config      String?  // JSON: apiKey, secretKey, webhookSecret, etc (encrypted fields marked)
  supportedMethods String? // JSON array: ["card", "upi", "netbanking", "wallet"]
  testMode    Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
}

model Voucher {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String    @unique
  batchId     String?
  type        String    @default("plan_subscription") // plan_subscription | topup | discount | credit
  planId      String?
  plan        Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  value       Decimal
  currency    String    @default("USD")
  durationDays Int?
  status      String    @default("unused") // unused | used | expired | disabled
  subscriberId String?
  subscriber  Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  redeemedAt  DateTime?
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([batchId])
  @@index([subscriberId])
}

// =====================================================================
// OPERATIONS (Phase 9) — stubs for dashboard
// =====================================================================

model Complaint {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNo    String   @unique
  subscriberId String?
  subscriber  Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  assignedTo  String?
  assignee    User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  subject     String
  description  String?
  category     String?  // billing | network | technical | other
  priority     String   @default("normal") // low | normal | high | urgent
  status       String   @default("open") // open | in_progress | resolved | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
  @@index([assignedTo])
}

model Technician {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  phone       String?
  email       String?
  employeeId  String?
  status      String   @default("active") // active | busy | off_duty
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installations Installation[]

  @@index([tenantId, status])
}

model Installation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrderNo   String   @unique
  subscriberId  String?
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  technicianId  String?
  technician    Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  type          String   @default("new_install") // new_install | upgrade | repair | disconnect | relocation
  status        String   @default("scheduled") // scheduled | in_progress | completed | cancelled | failed
  address       String?
  scheduledDate DateTime?
  completedAt   DateTime?
  notes         String?
  // Equipment used
  equipmentUsed String?  // JSON array of { item, quantity }
  // Coordinates
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([technicianId])
  @@index([subscriberId])
}

model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  category    String   @default("networking") // networking | cpe | cable | accessory | tool
  description String?
  unit        String   @default("unit") // unit | meter | box | roll
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  reorderPoint Int     @default(5)
  unitCost    Decimal
  unitPrice   Decimal?
  location    String?  // warehouse / shelf location
  status      String   @default("in_stock") // in_stock | low_stock | out_of_stock | reserved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, category])
}

model Incident {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentNo   String   @unique
  title       String
  description String?
  severity    String   @default("minor") // minor | major | critical | catastrophic
  status      String   @default("open") // open | acknowledged | resolved | closed
  category    String   @default("network") // network | system | security | power | other
  affectedAreas String? // comma-separated areas/subnets/services affected
  reportedBy  String?
  assignedTo  String?
  assignee    User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  startedAt    DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  resolution  String?
  rootCause   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, severity])
}

// =====================================================================
// MONITORING (Phase 6) — metrics, alerts, syslog
// =====================================================================

model MetricData {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric      String   // bandwidth_down | bandwidth_up | sessions | cpu | memory | latency | packet_loss
  value       Float
  unit        String   @default("mbps") // mbps | kbps | count | ms | percent | bps
  source      String?  // nas:ip | system | subscriber:customerId
  nasId       String?
  recordedAt   DateTime @default(now())

  @@index([tenantId, metric, recordedAt])
  @@index([source, recordedAt])
}

model Alert {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alertNo     String   @unique
  title       String
  description String?
  severity    String   @default("warning") // info | warning | error | critical
  status      String   @default("active") // active | acknowledged | resolved | suppressed
  category    String   @default("network") // network | system | aaa | billing | security
  source      String?  // nas:ip | subscriber:id | system
  threshold   Float?
  currentValue Float?
  triggeredAt DateTime @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([triggeredAt])
}

model SyslogEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  facility    String   // kernel | daemon | auth | local0 | etc
  severity    String   // emergency | alert | critical | error | warning | notice | info | debug
  priority    Int      // facility * 8 + severity
  message     String
  hostname    String?
  sourceIp    String?
  nasId       String?
  tag         String?  // application/process tag
  receivedAt  DateTime @default(now())

  @@index([tenantId, severity, receivedAt])
  @@index([tenantId, receivedAt])
  @@index([nasId, receivedAt])
}

// =====================================================================
// POLICY (Phase 5) — bandwidth, QoS, firewall, time access
// =====================================================================

model BandwidthProfile {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  downloadSpeed Int      // kbps
  uploadSpeed   Int      // kbps
  downloadBurst Int?     // kbps burst
  uploadBurst   Int?     // kbps burst
  burstThreshold Int?    // kbps
  burstTime     Int?     // seconds
  priority      Int      @default(8) // 1-8, 1=highest
  status        String   @default("active") // active | disabled
  assignedCount Int      @default(0) // computed: subscribers/plans using this
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model QosQueue {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  type          String   @default("pfifo") // pfifo | bfifo | codel | fq_codel | priority
  priority      Int      @default(8) // 1-8
  rateLimit     Int?     // kbps, null = unlimited
  ceilLimit     Int?     // kbps max
  quantum       Int?     // bytes
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model FirewallRule {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  action        String   @default("accept") // accept | drop | reject | masquerade
  chain         String   @default("forward") // input | output | forward
  protocol      String?  // tcp | udp | icmp | any
  srcAddress    String?  // CIDR or IP
  dstAddress    String?  // CIDR or IP
  srcPort       String?  // port or range
  dstPort       String?  // port or range
  interface     String?  // interface name
  direction     String?  // in | out
  priority      Int      @default(100)
  enabled       Boolean  @default(true)
  log           Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, enabled])
  @@index([chain, action])
}

model TimeAccessProfile {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  schedule      String   // JSON: { mon: [{start:"08:00",end:"22:00"}], tue: [...] }
  timezone      String   @default("UTC")
  action        String   @default("allow") // allow | deny — what to do outside schedule
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model CollectionTask {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriberId  String?
  subscriber    Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  type          String   @default("reminder") // reminder | warning | suspension_notice | final_notice
  status        String   @default("pending") // pending | contacted | resolved | escalated
  amount        Decimal
  currency      String   @default("USD")
  dueDate       DateTime
  daysOverdue   Int      @default(0)
  contactMethod String?  // phone | email | sms | whatsapp | visit
  contactNotes  String?
  contactedAt   DateTime?
  resolvedAt    DateTime?
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([subscriberId])
  @@index([invoiceId])
  @@index([dueDate])
}

// =====================================================================
// EVENTS — internal event log (for async processing & replay)
// =====================================================================

model EventLog {
  id          String   @id @default(cuid())
  tenantId    String?
  type        String   // e.g. subscriber.created, payment.received, session.started
  payload     String   // JSON
  source      String?  // module that emitted
  requestId   String?
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([type, processed, createdAt])
  @@index([tenantId, createdAt])
}

// =====================================================================
// NETWORK MANAGEMENT (Phase 4) — IPAM, Subnets, DHCP, DNS, Interfaces
// =====================================================================

model Subnet {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  network     String   // e.g. 192.168.1.0
  cidr        Int      // e.g. 24 (for /24)
  cidrNotation String // computed "192.168.1.0/24" for quick lookups
  gateway     String?
  dnsPrimary  String?
  dnsSecondary String?
  vlanId      Int?
  type        String   @default("data") // data | voice | management | guest | pppoe
  status      String   @default("active") // active | reserved | exhausted | archived
  description String?
  totalAddresses Int   @default(0) // 2^(32-cidr)
  usableAddresses Int @default(0) // total - 2 (network + broadcast)
  allocatedCount Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ipAddresses IpAddress[]
  dhcpLeases  DhcpLease[]

  @@unique([tenantId, cidrNotation])
  @@index([tenantId, status])
  @@index([tenantId, type])
}

model IpAddress {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subnetId    String
  subnet      Subnet   @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  ipAddress    String   @unique
  status      String   @default("available") // available | allocated | reserved | excluded
  assignedTo  String?  // subscriberId or hostname or device name
  assignedType String? // subscriber | nas | device | static | dhcp
  macAddress  String?
  hostname    String?
  notes       String?
  allocatedAt DateTime?
  allocatedBy String?  // userId or "system"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subnetId, status])
  @@index([tenantId, status])
  @@index([assignedTo])
}

model DhcpLease {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subnetId    String?
  subnet      Subnet?  @relation(fields: [subnetId], references: [id], onDelete: SetNull)
  ipAddress    String   @unique
  macAddress  String
  hostname    String?
  clientId    String?  // DHCP Client Identifier
  leaseStart  DateTime @default(now())
  leaseEnd    DateTime
  leaseTime   Int      // seconds
  state       String   @default("active") // active | expired | released | declined
  nasId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, state])
  @@index([subnetId])
  @@index([macAddress])
  @@index([leaseEnd])
}

model DnsZone {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @unique // e.g. example.com
  type        String   @default("forward") // forward | reverse
  soaSerial   Int      @default(1)
  soaRefresh  Int      @default(3600)
  soaRetry    Int      @default(900)
  soaExpire   Int      @default(604800)
  soaMinimum  Int      @default(86400)
  primaryNs   String?  // primary nameserver
  adminEmail  String?  // responsible person
  status      String   @default("active") // active | disabled
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     DnsRecord[]

  @@index([tenantId, status])
}

model DnsRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId      String
  zone        DnsZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String   // record name (e.g. "www" or "@" for apex)
  type        String   // A | AAAA | CNAME | MX | TXT | NS | SRV | PTR
  value       String   // record value
  ttl         Int      @default(3600)
  priority    Int?     // for MX records
  weight      Int?     // for SRV records
  port        Int?     // for SRV records
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId, type])
  @@index([tenantId, name])
}

model SystemInterface {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // e.g. ether1, wan0, pppoe-out1
  displayName String?
  type        String   @default("ethernet") // ethernet | vlan | pppoe | bridge | loopback | wan
  ipAddress   String?  // primary IP (CIDR notation e.g. 192.168.1.1/24)
  macAddress  String?
  vlanId      Int?
  mtu         Int      @default(1500)
  enabled     Boolean  @default(true)
  rxBytes     BigInt   @default(0)
  txBytes     BigInt   @default(0)
  rxPackets   BigInt   @default(0)
  txPackets   BigInt   @default(0)
  rxErrors    Int      @default(0)
  txErrors    Int      @default(0)
  linkStatus  String   @default("up") // up | down | unknown
  speedMbps   Int?     // negotiated speed
  duplex      String?  // full | half | auto
  nasId       String?  // associated NAS device
  description String?
  lastUpdated DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, enabled])
  @@index([nasId])
}
