  rateLimit     Int?     // kbps for rate_limit action
  enabled       Boolean  @default(true)
  hits          Int      @default(0)
  lastHitAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, enabled])
  alerts IpsAlert[]
}

model IpsAlert {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId        String?
  rule          IpsRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  severity      String   @default("warning") // info | warning | error | critical
  sourceIp      String
  destIp        String
  protocol      String?
  description   String
  action        String   @default("alerted") // alerted | blocked | rate_limited
  blocked       Boolean  @default(false)
  timestamp     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId, severity, timestamp])
  @@index([sourceIp])
}

model NdpiRule {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appName       String   // e.g. "YouTube", "Netflix", "BitTorrent"
  category      String   // e.g. "Streaming", "P2P", "Social"
  action        String   @default("allow") // allow | block | rate_limit | shape
  rateLimit     Int?     // kbps
  scope         String   @default("global") // global | plan | subscriber | ip_range
  scopeValue    String?  // plan ID, subscriber ID, or IP range
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, enabled])
  @@index([category])
}

// =====================================================================
// VPN Server (WireGuard) + DDoS Protection + MultiWAN
// =====================================================================

model VpnPeer {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  publicKey     String   @unique
  privateKey    String?  // encrypted
  allowedIps    String   // CIDR
  endpoint      String?  // IP:port
  persistentKeepalive Int? @default(25)
  enabled       Boolean  @default(true)
  status        String   @default("inactive") // active | inactive | error
  lastHandshake DateTime?
  rxBytes       BigInt   @default(0)
  txBytes       BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, enabled])
}

model DdosRule {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  type          String   @default("syn_flood") // syn_flood | udp_flood | icmp_flood | slowloris | volumetric
  action        String   @default("block") // block | rate_limit | challenge
  threshold     Int      @default(100) // packets per second
  windowSeconds Int      @default(10)
  enabled       Boolean  @default(true)
  triggers      Int      @default(0)
  lastTriggered DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, enabled])
}

model WanLink {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  interface     String   // e.g. eth0, pppoe-wan1
  isp           String?
  ipAddress     String?
  gateway       String?
  downloadSpeed Int?     // kbps
  uploadSpeed   Int?     // kbps
  priority      Int      @default(1) // 1 = primary, 2 = backup
  status        String   @default("up") // up | down | degraded
  failoverEnabled Boolean @default(true)
  rxBytes       BigInt   @default(0)
  txBytes       BigInt   @default(0)
  latency       Float?   // ms
  packetLoss    Float?   // percent
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([priority])
}

// =====================================================================
// Enterprise Auth (LDAP/AD) + WiFi Offload (Diameter)
// =====================================================================

model EnterpriseAuthConfig {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  type          String   @default("ldap") // ldap | ad | radius_proxy
  serverUrl     String   // ldap://host:389 or ldaps://host:636
  bindDn        String   // CN=admin,DC=example,DC=com
  bindPassword  String   // encrypted
  searchBase    String   // OU=users,DC=example,DC=com
  searchFilter  String   @default("(uid={username})")
  groupAttribute String  @default("memberOf")
  enabled       Boolean  @default(true)
  testStatus    String   @default("untested") // untested | success | failure
  lastTestedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
}

model WifiOffloadPeer {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  realm         String   @unique
  type          String   @default("gy") // gy | gx | swa | s6b
  serverAddress String
  serverPort    Int      @default(3868)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
}

// =====================================================================
// Deployment Presets + Knowledge Base + Expenses
// =====================================================================

model DeploymentPreset {
  id            String   @id @default(cuid())
  name          String   @unique // isp | education | hospital | hotel | campus | enterprise | full
  displayName   String
  description   String?
  modules       String   // JSON array of module IDs to enable
  config        String?  // JSON of preset-specific config
  icon          String?
  createdAt     DateTime @default(now())
}

model KnowledgeBase {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  slug          String   @unique
  content       String
  category      String   @default("general") // general | billing | network | aaa | troubleshooting | faq
  tags          String?  // JSON array
  published     Boolean  @default(true)
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, category, published])
}

model Expense {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description   String
  amount        Float
  currency      String   @default("USD")
  category      String   @default("operational") // operational | salary | equipment | utility | rent | marketing | other
  date          DateTime @default(now())
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([tenantId, category, date])
  @@index([date])
}

// =====================================================================
// EVENTS — internal event log (for async processing & replay)
// =====================================================================

model EventLog {
  id          String   @id @default(cuid())
  tenantId    String?
  type        String   // e.g. subscriber.created, payment.received, session.started
  payload     String   // JSON
  source      String?  // module that emitted
  requestId   String?
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([type, processed, createdAt])
  @@index([tenantId, createdAt])
}

// =====================================================================
// NETWORK MANAGEMENT (Phase 4) — IPAM, Subnets, DHCP, DNS, Interfaces
// =====================================================================

model Subnet {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  network     String   // e.g. 192.168.1.0
  cidr        Int      // e.g. 24 (for /24)
  cidrNotation String // computed "192.168.1.0/24" for quick lookups
  gateway     String?
  dnsPrimary  String?
  dnsSecondary String?
  vlanId      Int?
  type        String   @default("data") // data | voice | management | guest | pppoe
  status      String   @default("active") // active | reserved | exhausted | archived
  description String?
  totalAddresses Int   @default(0) // 2^(32-cidr)
  usableAddresses Int @default(0) // total - 2 (network + broadcast)
  allocatedCount Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ipAddresses IpAddress[]
  dhcpLeases  DhcpLease[]

  @@unique([tenantId, cidrNotation])
  @@index([tenantId, status])
  @@index([tenantId, type])
}

model IpAddress {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subnetId    String
  subnet      Subnet   @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  ipAddress    String   @unique
  status      String   @default("available") // available | allocated | reserved | excluded
  assignedTo  String?  // subscriberId or hostname or device name
  assignedType String? // subscriber | nas | device | static | dhcp
  macAddress  String?
  hostname    String?
  notes       String?
  allocatedAt DateTime?
  allocatedBy String?  // userId or "system"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subnetId, status])
  @@index([tenantId, status])
  @@index([assignedTo])
}

model DhcpLease {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subnetId    String?
  subnet      Subnet?  @relation(fields: [subnetId], references: [id], onDelete: SetNull)
  ipAddress    String   @unique
  macAddress  String
  hostname    String?
  clientId    String?  // DHCP Client Identifier
  leaseStart  DateTime @default(now())
  leaseEnd    DateTime
  leaseTime   Int      // seconds
  state       String   @default("active") // active | expired | released | declined
  nasId       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, state])
  @@index([subnetId])
  @@index([macAddress])
  @@index([leaseEnd])
}

model DnsZone {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @unique // e.g. example.com
  type        String   @default("forward") // forward | reverse
  soaSerial   Int      @default(1)
  soaRefresh  Int      @default(3600)
  soaRetry    Int      @default(900)
  soaExpire   Int      @default(604800)
  soaMinimum  Int      @default(86400)
  primaryNs   String?  // primary nameserver
  adminEmail  String?  // responsible person
  status      String   @default("active") // active | disabled
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     DnsRecord[]

  @@index([tenantId, status])
}

model DnsRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId      String
  zone        DnsZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String   // record name (e.g. "www" or "@" for apex)
  type        String   // A | AAAA | CNAME | MX | TXT | NS | SRV | PTR
  value       String   // record value
  ttl         Int      @default(3600)
  priority    Int?     // for MX records
  weight      Int?     // for SRV records
  port        Int?     // for SRV records
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([zoneId, type])
  @@index([tenantId, name])
}

model SystemInterface {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // e.g. ether1, wan0, pppoe-out1
  displayName String?
  type        String   @default("ethernet") // ethernet | vlan | pppoe | bridge | loopback | wan
  ipAddress   String?  // primary IP (CIDR notation e.g. 192.168.1.1/24)
  macAddress  String?
  vlanId      Int?
  mtu         Int      @default(1500)
  enabled     Boolean  @default(true)
  rxBytes     BigInt   @default(0)
  txBytes     BigInt   @default(0)
  rxPackets   BigInt   @default(0)
  txPackets   BigInt   @default(0)
  rxErrors    Int      @default(0)
  txErrors    Int      @default(0)
  linkStatus  String   @default("up") // up | down | unknown
  speedMbps   Int?     // negotiated speed
  duplex      String?  // full | half | auto
  nasId       String?  // associated NAS device
  description String?
  lastUpdated DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, enabled])
  @@index([nasId])
}
